# =============================================================================
# juniper-data Environment Variables
# All settings use the JUNIPER_DATA_ prefix.
# Copy this file to .env and customize as needed.
# =============================================================================

# Server
JUNIPER_DATA_HOST=0.0.0.0
JUNIPER_DATA_PORT=8100
JUNIPER_DATA_LOG_LEVEL=INFO
JUNIPER_DATA_STORAGE_PATH=./data/datasets

# API Security (optional — disabled when unset)
# JUNIPER_DATA_API_KEYS=key1,key2
# SEC-F01 fail-closed posture: with true, startup REFUSES when no real API key
# is configured (default false = loud WARNING only). Set true wherever secrets
# are provisioned (the composed juniper-deploy stack).
# JUNIPER_DATA_REQUIRE_AUTH=true
# JUNIPER_DATA_RATE_LIMIT_ENABLED=false
# JUNIPER_DATA_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Generator defaults (import-time, not Settings — set before the process starts)
# JUNIPER_DATA_DEFAULT_GENERATOR_SEED=42
# JUNIPER_DATA_DEFAULT_MACKEY_GLASS_INIT_NOISE_STD=0.0
