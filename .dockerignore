# =============================================================================
# JuniperData Docker Build Exclusions
# =============================================================================
# Excludes files not needed in the Docker build context to reduce image size
# and build time. Keep in sync with .gitignore where applicable.
# =============================================================================

# Git and version control
.git/
.gitignore
.github/

# IDE and editor files
.vscode/
.idea/
.trunk/
*.swp
*.swo

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
# ``*.egg-info/`` matches only the context root. juniper-data is not vulnerable
# to the build-provenance version-shadow today (it runs ``python -m juniper_data``
# off the installed package, and its egg-info is at the repo root) — these nested
# forms are defense-in-depth + ecosystem consistency with the canopy #362 / cascor
# fixes (a stale ``*/foo.egg-info`` COPYed onto an import path can shadow the
# installed package version).
**/*.egg-info/
**/*.dist-info/
*.egg
dist/
build/
wheels/
*.whl

# Test and coverage
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
reports/
*.prof
TEST*.xml
TEST*.html

# Development tools
.pre-commit-config.yaml
.serena/
.claude/

# Documentation (not needed at runtime)
docs/
notes/
*.md
!README.md

# Local data and logs (will be mounted as volumes)
data/
logs/
images/

# Configuration files not needed in container
conf/
util/
src/

# Temporary files
*.tmp
*.temp
*.log
*.out

# Large media files
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.gif
*.png
*.xcf

# Archives
*.gz
*.tgz
*.tar
*.zip
*.bz
